{
    "name": "security-attack-defense-fe",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "watch:lint": "node scripts/watch-lint.js",
        "start": "concurrently -n \"vite,watch\" -c \"cyan,magenta\" \"vite --host --mode dev\" \"pnpm watch:lint\"",
        "start:dev": "concurrently -n \"vite,watch\" -c \"cyan,magenta\" \"vite --host --mode dev\" \"pnpm watch:lint\"",
        "start:staging": "concurrently -n \"vite,watch\" -c \"cyan,magenta\" \"vite --host --mode staging\" \"pnpm watch:lint\"",
        "start:prod": "concurrently -n \"vite,watch\" -c \"cyan,magenta\" \"vite --host --mode production\" \"pnpm watch:lint\"",
        "build": "tsc && vite build",
        "build:dev": "tsc && vite build --mode dev",
        "build:staging": "tsc && vite build --mode staging",
        "build:prod": "tsc && vite build --mode production",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest run --coverage",
        "preview": "vite preview",
        "prettier": "prettier --write .",
        "prettier:check": "prettier --check .",
        "prepare": "if [ \"$CI\" = \"true\" ] || [ \"$HUSKY\" = \"0\" ]; then echo \"skip governance setup in CI\"; else husky && git submodule update --init --remote && .governance/setup.sh; fi",
        "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings 999",
        "lint-fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
        "ls-lint": "ls-lint",
        "check": "pnpm prettier:check && pnpm lint && pnpm ls-lint",
        "prebuild": "pnpm check",
        "start:demo": "vite --host 127.0.0.1 --mode demo",
        "build:pages": "vite build --mode demo"
    },
    "devDependencies": {
        "@babel/plugin-proposal-optional-chaining": "^7.21.0",
        "@eslint/js": "^10.0.1",
        "@ls-lint/ls-lint": "^2.2.3",
        "@tailwindcss/vite": "^4.1.7",
        "@testing-library/jest-dom": "6.6.3",
        "@testing-library/react": "14.3.1",
        "@testing-library/user-event": "14.5.2",
        "@types/classnames": "^2.3.1",
        "@types/node": "^18.15.11",
        "@types/react": "^18.0.28",
        "@types/react-dom": "^18.0.11",
        "@vitejs/plugin-react": "^4.3.1",
        "@vitest/coverage-v8": "3.2.6",
        "concurrently": "^8.2.2",
        "eslint": "9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.6.0",
        "husky": "^9.0.0",
        "jsdom": "24.1.3",
        "less": "^4.1.3",
        "lint-staged": "^15.2.12",
        "prettier": "^3.0.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tailwindcss": "^4.1.7",
        "terser": "^5.16.9",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.59.4",
        "vite": "^5.4.0",
        "vite-babel-plugin": "^0.0.2",
        "vitest": "3.2.6"
    },
    "dependencies": {
        "@ant-design/icons": "5.6.1",
        "@easycode/client-detector": "^1.3.5",
        "@tanstack/react-query": "5.66.11",
        "ahooks": "3.9.7",
        "antd": "^5.4.5",
        "axios": "^1.3.5",
        "classnames": "^2.3.2",
        "html2pdf.js": "^0.14.0",
        "react-markdown": "^9.1.0",
        "react-router": "^6.11.2",
        "react-router-dom": "^6.11.2",
        "remark-gfm": "^4.0.1",
        "zustand": "5.0.3"
    },
    "lint-staged": {
        "**/*.{ts,tsx,js,jsx}": [
            "prettier --write",
            "eslint src --fix --ext .js,.jsx,.ts,.tsx"
        ],
        "**/*.{less,module.less,json,md,html}": [
            "prettier --write"
        ]
    },
    "packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b"
}
